<?php
/** Executable filtered image alt accessibility fixture. */
define( 'ABSPATH', dirname( __DIR__, 2 ) . '/' );
function wp_strip_all_tags( $value ) { return strip_tags( $value ); }
class WP_HTML_Tag_Processor {
	private $attributes;
	public function __construct( $alt ) { $this->attributes = null === $alt ? array() : array( 'alt' => $alt ); }
	public function get_attribute( $name ) { return isset( $this->attributes[ $name ] ) ? $this->attributes[ $name ] : null; }
	public function set_attribute( $name, $value ) { $this->attributes[ $name ] = $value; }
}
require dirname( __DIR__, 2 ) . '/inc/template-tags.php';
require dirname( __DIR__, 2 ) . '/inc/media-source.php';
$cases = array(
	array( null, '' ),
	array( false, '' ),
	array( true, '' ),
	array( array( 'invalid' ), '' ),
	array( 42, '' ),
	array( '', '' ),
	array( ' ', '' ),
	array( '&#x200B;', '' ),
	array( '&#x3164;', '' ),
	array( "\u{200B}", '' ),
	array( "\u{0301}", '' ),
	array( "\u{2800}", '' ),
	array( '写真', '写真' ),
	array( 'صورة', 'صورة' ),
	array( '📷', '📷' ),
	array( 'A photo of a landscape', 'A photo of a landscape' ),
	array( '123', '123' ),
	array( '&lt;3', '&lt;3' ),
	array( '日本語 العربية', '日本語 العربية' ),
);
foreach ( $cases as $case ) {
	$processor = new WP_HTML_Tag_Processor( $case[0] );
	slateframe_normalize_image_alt( $processor );
	if ( $processor->get_attribute( 'alt' ) !== $case[1] ) {
		throw new RuntimeException( 'Unexpected alt: ' . $case[0] );
	}
}
echo 'Image alt normalization: ' . count( $cases ) . " cases passed\n";
