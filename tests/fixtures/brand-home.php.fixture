<?php
/** Exercise the real header for empty and readable Core site names. */
define( 'COOKIEPATH', '/' );
define( 'ABSPATH', __DIR__ );
function wp_strip_all_tags( $value ) { return strip_tags( $value ); }
require dirname( __DIR__, 2 ) . '/inc/template-tags.php';
$GLOBALS['slateframe_brand_test_title'] = '';
$GLOBALS['slateframe_brand_test_description'] = '';
$GLOBALS['slateframe_brand_test_logo'] = false;
$GLOBALS['slateframe_brand_test_logo_valid'] = true;
function has_custom_logo() { return $GLOBALS['slateframe_brand_test_logo']; }
function get_theme_mod( $name ) { return $GLOBALS['slateframe_brand_test_logo'] ? 42 : 0; }
function wp_attachment_is_image( $id ) { return 42 === $id && $GLOBALS['slateframe_brand_test_logo_valid']; }
function get_bloginfo( $key ) {
    if ( 'name' === $key ) {
        return $GLOBALS['slateframe_brand_test_title'];
    }
    if ( 'description' === $key ) {
        return $GLOBALS['slateframe_brand_test_description'];
    }
    return 'UTF-8';
}
function bloginfo( $key ) { echo htmlspecialchars( get_bloginfo( $key, 'display' ), ENT_QUOTES, 'UTF-8' ); }
function language_attributes() { echo 'lang="en-US"'; }
function wp_head() {}
function body_class() { echo 'class="home"'; }
function wp_body_open() {}
function home_url( $path ) { return '/'; }
function esc_url( $value ) { return $value; }
function esc_attr( $value ) { return htmlspecialchars( $value, ENT_QUOTES, 'UTF-8' ); }
function slateframe_brand_mark() { if ( $GLOBALS['slateframe_brand_test_logo_valid'] && $GLOBALS['slateframe_brand_test_logo'] ) { echo '<img src="/logo.png" alt="">'; } }
function wp_nav_menu( $args ) {}
function slateframe_language_switcher() {}
function esc_attr_e( $value, $domain ) { echo htmlspecialchars( $value, ENT_QUOTES, 'UTF-8' ); }
function esc_html_e( $value, $domain ) { echo htmlspecialchars( $value, ENT_QUOTES, 'UTF-8' ); }
$cases = array(
    array( '', '', false, true ),
    array( '  ', '日本語と中文', false, true ),
    array( '', 'العربية', true, true ),
    array( 'Slateframe', '', false, false ),
    array( '日本語', 'العربية', false, false ),
    array( 'العربية', '', true, false ),
    array( '0', '', false, false ),
    array( "\u{3000}", '', false, true ),
    array( "\u{200B}", '日本語と中文', true, true ),
    array( '&nbsp;', '', false, true ),
    array( "\u{FE0F}", '', true, true ),
    array( "\u{3164}", '', false, true ),
    array( '👩‍💻', '', false, false ),
    array( null, '', false, true ),
    array( false, '', true, true ),
    array( array( 'broken' ), '日本語', false, true ),
    array( '', '', true, true, false ),
    array( "\u{200B}", '', true, true, false ),
    array( 'Slateframe', "\u{200B}", false, false ),
);
foreach ( $cases as $index => $case ) {
    $GLOBALS['slateframe_brand_test_title'] = $case[0];
    $GLOBALS['slateframe_brand_test_description'] = $case[1];
    $GLOBALS['slateframe_brand_test_logo'] = $case[2];
    $GLOBALS['slateframe_brand_test_logo_valid'] = $case[4] ?? true;
    $renderable_logo = $case[2] && $GLOBALS['slateframe_brand_test_logo_valid'];
    ob_start();
    require dirname( __DIR__, 2 ) . '/header.php';
    $html = ob_get_clean();
    $has_title = 1 === preg_match( '/<span class="slateframe-brand-title"><bdi>(.*?)<\/bdi><\/span>/s', $html, $matches );
    $visible_label = $has_title ? trim( html_entity_decode( strip_tags( $matches[1] ), ENT_QUOTES | ENT_HTML5, 'UTF-8' ) ) : '';
    $has_screen_reader_home = false !== strpos( $html, '<span class="screen-reader-text">Home</span>' );
    if ( $case[3] ) {
        if ( $renderable_logo && ( $has_title || ! $has_screen_reader_home ) ) {
            throw new RuntimeException( 'Case ' . $index . ' logo fallback incorrect' );
        }
        if ( ! $renderable_logo && ( ! $has_title || 'Home' !== $visible_label || $has_screen_reader_home ) ) {
            throw new RuntimeException( 'Case ' . $index . ' visible fallback incorrect' );
        }
    } elseif ( ! $has_title || $has_screen_reader_home || $visible_label !== $case[0] ) {
        throw new RuntimeException( 'Case ' . $index . ' valid name changed' );
    }
    if ( ! slateframe_has_readable_label( $case[1] ) && false !== strpos( $html, 'slateframe-brand-tagline' ) ) {
        throw new RuntimeException( 'Case ' . $index . ' rendered an invisible tagline' );
    }
    if ( false === strpos( $html, 'class="slateframe-brand"' ) || false === strpos( $html, 'href="/"' ) ) {
        throw new RuntimeException( 'Case ' . $index . ' lost Core brand link' );
    }
}
echo 'Brand accessible home: ' . count( $cases ) . " cases passed\n";
