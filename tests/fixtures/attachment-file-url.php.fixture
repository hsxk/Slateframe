<?php
/** Executable Core attachment recovery URL boundary fixture. */
define( 'ABSPATH', dirname( __DIR__, 2 ) . '/' );
function wp_strip_all_tags( $value ) { return strip_tags( $value ); }
function esc_url_raw( $url, $protocols = null ) {
	// Simulate a later clean_url filter overriding Core's protocol validation.
	if ( 'https://example.org/filter-rewrite' === $url ) { return 'mailto:editor@example.org'; }
	if ( 'https://example.org/filter-data' === $url ) { return 'data:image/svg+xml,abc'; }
	if ( 'https://example.org/filter-cdn' === $url ) { return 'https://cdn.example.org/写真.jpg'; }
	if ( 'https://example.org/filter-relative' === $url ) { return '/uploads/写真.jpg'; }
	if ( preg_match( '/^([a-z][a-z0-9+.-]*):/i', $url, $matches ) ) {
		$scheme = strtolower( $matches[1] );
		if ( in_array( $scheme, array( 'javascript', 'data', 'vbscript' ), true ) || ( is_array( $protocols ) && ! in_array( $scheme, $protocols, true ) ) ) {
			return '';
		}
	}
	return trim( $url );
}
function wp_parse_url( $url, $component = -1 ) { return parse_url( $url, $component ); }
require dirname( __DIR__, 2 ) . '/inc/template-tags.php';
require dirname( __DIR__, 2 ) . '/inc/media-source.php';
$cases = array(
	array( 'https://example.org/photo.jpg', true, 'HTTPS image' ),
	array( 'http://example.org/video.mp4', true, 'HTTP video' ),
	array( '/uploads/photo.jpg', true, 'relative path' ),
	array( '/写真.jpg', true, 'CJK path' ),
	array( '/صورة.jpg', true, 'Arabic path' ),
	array( '/📷.jpg', true, 'emoji path' ),
	array( 'https://example.org/?a=1&b=2', true, 'query parameters' ),
	array( '/%E5%86%99%E7%9C%9F.jpg', true, 'encoded CJK path' ),
	array( '&#x200B;', false, 'entity zero width' ),
	array( '&#x3164;', false, 'entity Hangul filler' ),
	array( '%E2%80%8B', false, 'encoded zero width' ),
	array( '%E3%85%A4', false, 'encoded Hangul filler' ),
	array( "\u{200D}", false, 'literal zero width joiner' ),
	array( "\u{2800}", false, 'Braille blank' ),
	array( "\u{0301}", false, 'combining mark' ),
	array( ' ', false, 'whitespace' ),
	array( '', false, 'empty string' ),
	array( 'javascript:alert(1)', false, 'unsafe protocol' ),
	array( null, false, 'null' ),
	array( false, false, 'boolean' ),
	array( 42, false, 'number' ),
	array( array( 'url' ), false, 'array' ),
	array( '//cdn.example.org/photo.jpg', true, 'protocol-relative CDN' ),
	array( 'https://example.org/photo.jpg#fragment', true, 'HTTP fragment' ),
	array( 'mailto:editor@example.org', false, 'email is not a file' ),
	array( 'tel:+12025550123', false, 'telephone is not a file' ),
	array( 'ftp://example.org/photo.jpg', false, 'FTP is not web media' ),
	array( 'ftps://example.org/photo.jpg', false, 'FTPS is not web media' ),
	array( 'news:example.org', false, 'news protocol' ),
	array( 'irc://example.org/channel', false, 'chat protocol' ),
	array( 'https://example.org/filter-rewrite', false, 'filtered mailto rewrite' ),
	array( 'https://example.org/filter-data', false, 'filtered data rewrite' ),
	array( 'https://example.org/filter-cdn', true, 'filtered valid CDN rewrite' ),
	array( 'https://example.org/filter-relative', true, 'filtered valid relative rewrite' ),
	array( 'https://', false, 'hostless HTTPS URL' ),
	array( 'https:foo', false, 'malformed absolute HTTPS URL' ),
	array( 'HTTPS://EXAMPLE.ORG/photo.jpg', true, 'uppercase HTTPS scheme' ),
);
foreach ( $cases as $case ) {
	$url = slateframe_attachment_file_url( $case[0] );
	if ( ( '' !== $url ) !== $case[1] ) {
		throw new RuntimeException( 'Failed: ' . $case[2] );
	}
}
echo 'Attachment recovery URL: ' . count( $cases ) . " cases passed\n";
