<?php
/**
 * Deterministic WordPress Core RSS render fixture, executed by wp eval-file.
 *
 * The pre_http_request hook supplies only this synthetic feed URL; no remote
 * service is contacted, and production theme code never installs the hook.
 */
$slateframe_feed_url = 'https://example.org/slateframe-rss-fixture.xml';
// Unique descending dates make SimplePie's native newest-first ordering deterministic.
// Equal timestamps may be returned in a different order across PHP/WP builds.
$slateframe_xml = file_get_contents( __DIR__ . '/core-rss-feed.xml' );
if ( false === $slateframe_xml ) {
	fwrite( STDERR, 'Synthetic RSS fixture XML missing.' . PHP_EOL );
	exit( 1 );
}
add_filter(
	'pre_http_request',
	static function ( $pre, $args, $url ) use ( $slateframe_feed_url, $slateframe_xml ) {
		if ( $url !== $slateframe_feed_url ) {
			return $pre;
		}
		return array(
			'headers'  => array( 'content-type' => 'application/rss+xml; charset=UTF-8' ),
			'body'     => $slateframe_xml,
			'response' => array( 'code' => 200, 'message' => 'OK' ),
			'cookies'  => array(),
		);
	},
	10,
	3
);
$slateframe_rendered = array();
foreach ( array( 'list', 'grid' ) as $layout ) {
	$slateframe_html = render_block(
		array(
			'blockName'    => 'core/rss',
			'attrs'        => array(
				'feedURL'        => $slateframe_feed_url,
				'itemsToShow'    => 3,
				'displayExcerpt' => true,
				'displayAuthor'  => true,
				'displayDate'    => true,
				'blockLayout'    => $layout,
				'columns'        => 3,
			),
			'innerBlocks'  => array(),
			'innerHTML'    => '',
			'innerContent' => array(),
		)
	);
	if ( 3 !== substr_count( $slateframe_html, 'wp-block-rss__item-title' ) ) {
		fwrite( STDERR, 'WordPress Core RSS did not render three native feed entries.' . PHP_EOL );
		exit( 1 );
	}
	$slateframe_rendered[ $layout ] = $slateframe_html;
}
echo wp_json_encode( $slateframe_rendered, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES );
