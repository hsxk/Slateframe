<?php
/** Regression for readable absolute media hosts and relative Core endpoints. */
define( 'ABSPATH', dirname( __DIR__, 2 ) . '/' );

function slateframe_has_readable_label( $text ) {
	if ( ! is_string( $text ) ) {
		return false;
	}
	$plain = html_entity_decode( strip_tags( $text ), ENT_QUOTES | ENT_HTML5, 'UTF-8' );
	return 1 === preg_match( '/[^\p{Z}\p{Cc}\p{Cf}\p{M}\x{115F}\x{1160}\x{3164}\x{FFA0}\x{2800}\s]/u', $plain );
}

function wp_parse_url( $url, $component = -1 ) {
	return parse_url( $url, $component );
}

function esc_url_raw( $url, $protocols = array() ) {
	return $url;
}

require dirname( __DIR__, 2 ) . '/inc/media-source.php';

$urls = array(
	array( 'https://example.org/写真.jpg', true ),
	array( '//cdn.example.org/صورة.jpg', true ),
	array( '//[2001:db8::1]/photo.jpg', true ),
	array( '/写真.jpg', true ),
	array( '?image=1', true ),
	array( '../img/写真.jpg', true ),
	array( 'https://', false ),
	array( '//', false ),
	array( '///', false ),
	array( '//%20/photo.jpg', false ),
	array( 'https://%20/photo.jpg', false ),
	array( '//%E2%80%8B/abc', false ),
	array( 'https://%E2%80%8B/abc', false ),
	array( 'https://%CC%81/abc', false ),
	array( '//%2F/photo.jpg', false ),
	array( 'https://%23/photo.jpg', false ),
	array( '//%2E/photo.jpg', false ),
	array( '//%40/photo.jpg', false ),
	array( '//%3F/photo.jpg', false ),
	array( '//%2D/photo.jpg', false ),
	array( '//%2A/photo.jpg', false ),
	array( 'https://example%2F.org/photo.jpg', false ),
	array( '//%2Fcdn.example.org/photo.jpg', false ),
	array( 'https://example%23.org/photo.jpg', false ),
	array( 'https://example%3F.org/photo.jpg', false ),
	array( 'https://example%40.org/photo.jpg', false ),
	array( 'https://example%5C.org/photo.jpg', false ),
	array( 'https://example%20.org/photo.jpg', false ),
	array( 'https://example%00.org/photo.jpg', false ),
	array( 'https://example%3A8080/photo.jpg', false ),
	array( 'https://example%7F.org/photo.jpg', false ),
	array( 'https://%2Fexample.org/photo.jpg', false ),
	array( 'https://example%09.org/photo.jpg', false ),
	array( 'https://%E4%BE%8B%E5%AD%90.%E6%B5%8B%E8%AF%95/photo.jpg', true ),
	array( 'https://example.org:8443/photo.jpg', true ),
	array( 'ftp://example.org/a.jpg', false ),
	array( 'mailto:owner@example.org', false ),
	array( '#fragment', false ),
	array( '  //%20/photo.jpg', false ),
	array( '  //%2F/photo.jpg', false ),
	array( '  https://example%2F.org/photo.jpg', false ),
	array( '  javascript:alert(1)', false ),
	array( "ja\nvascript:alert(1)", false ),
	array( "https://example.org/\nphoto.jpg", false ),
	array( " \t//cdn.example.org/photo.jpg", false ),
	array( '  //cdn.example.org/photo.jpg', true ),
	array( '  https://example.org/photo.jpg', true ),
	array( '  #fragment', false ),
	array( '  ftp://example.org/file.jpg', false ),
	array( '  https://', false ),
	array( '  mailto:owner@example.org', false ),
	// Browser URL parsing treats leading backslashes as authority separators.
	array( '\\\\evil.test/photo.jpg', false ),
	array( '/\\evil.test/photo.jpg', false ),
	array( '\\/evil.test/photo.jpg', false ),
	// PHP and browsers disagree on backslashes before authority userinfo.
	array( '//safe.test\\@evil.test/photo.jpg', false ),
	array( 'https://safe.test\\@evil.test/photo.jpg', false ),
	// Ordinary path backslashes remain compatible with Core media markup.
	array( 'https://safe.test/images\\photo.jpg', true ),
	// Unicode bidi controls can make a hostname browser-invalid; zero-width
	// spaces may be removed by URL parsing and silently change its host.
	array( 'https://exam%E2%80%AEple.org/photo.jpg', false ),
	array( 'https://exam%E2%81%A6ple.org/photo.jpg', false ),
	array( 'https://exa%E2%80%8Bmple.org/photo.jpg', false ),
	array( 'https://exam%E2%80%8Fple.org/photo.jpg', false ),
	array( '//exam%E2%80%AEple.org/photo.jpg', false ),
	array( 'https://exam%E2%81%A9ple.org/photo.jpg', false ),
	array( 'https://مثال.إختبار/photo.jpg', true ),
	array( 'https://例子.测试/photo.jpg', true ),
	array( '/images\\photo.jpg', true ),
);

foreach ( $urls as $case ) {
	if ( slateframe_has_web_media_url( $case[0] ) !== $case[1] ) {
		throw new RuntimeException( 'Invalid URL host result: ' . $case[0] );
	}
}

$images = array(
	array( null, '//%20/photo.jpg 1x', false ),
	array( null, '//%E2%80%8B/photo.jpg 2x', false ),
	array( null, '//%20/photo.jpg 1x, /valid.jpg 2x', true ),
	array( null, 'https://%20/photo.jpg 1x', false ),
	array( null, '//cdn.example.org/写真.jpg 1x', true ),
	array( null, 'https://例子.测试/写真.jpg 2x', true ),
	array( '//%20/photo.jpg', null, false ),
	array( '/valid.jpg', '//%20/photo.jpg 2x', true ),
	array( null, '//%2F/photo.jpg 2x', false ),
	array( null, '//%2F/photo.jpg 1x, /valid.jpg 2x', true ),
	array( null, 'https://example%2F.org/photo.jpg 1x', false ),
	array( null, 'https://example%2F.org/photo.jpg 1x, /valid.jpg 2x', true ),
	array( null, 'https://%E4%BE%8B%E5%AD%90.%E6%B5%8B%E8%AF%95/photo.jpg 2x', true ),
	array( '  javascript:alert(1)', null, false ),
	array( '  //%20/photo.jpg', null, false ),
	array( '  //cdn.example.org/photo.jpg', null, true ),
	array( "https://example.org/\nphoto.jpg", null, false ),
	array( '\\\\evil.test/photo.jpg', null, false ),
	array( '/\\evil.test/photo.jpg', null, false ),
	array( null, '//safe.test\\@evil.test/photo.jpg 1x', false ),
	array( null, '//safe.test\\@evil.test/photo.jpg 1x, /valid.jpg 2x', true ),
	array( null, 'https://exa%E2%80%8Bmple.org/photo.jpg 1x', false ),
	array( null, 'https://exam%E2%80%AEple.org/photo.jpg 1x, /valid.jpg 2x', true ),
	array( null, 'https://مثال.إختبار/photo.jpg 1x', true ),
);

foreach ( $images as $case ) {
	if ( slateframe_image_has_source( $case[0], $case[1] ) !== $case[2] ) {
		throw new RuntimeException( 'Invalid srcset host result: ' . $case[1] );
	}
}

$attachments = array(
	array( '//%20/file.pdf', '' ),
	array( 'https://%E2%80%8B/file.pdf', '' ),
	array( 'https://example.org/file.pdf', 'https://example.org/file.pdf' ),
	array( '//cdn.example.org/ファイル.pdf', '//cdn.example.org/ファイル.pdf' ),
	array( '/files/資料.pdf', '/files/資料.pdf' ),
	array( '//%2E/file.pdf', '' ),
	array( 'https://%23/file.pdf', '' ),
	array( 'https://example%2F.org/file.pdf', '' ),
	array( '//example%40.org/file.pdf', '' ),
	array( 'https://%E4%BE%8B%E5%AD%90.%E6%B5%8B%E8%AF%95/file.pdf', 'https://%E4%BE%8B%E5%AD%90.%E6%B5%8B%E8%AF%95/file.pdf' ),
	array( '  javascript:alert(1)', '' ),
	array( '  //%20/file.pdf', '' ),
	array( '  //cdn.example.org/file.pdf', '  //cdn.example.org/file.pdf' ),
	array( "https://example.org/\nfile.pdf", '' ),
	array( '\\\\evil.test/file.pdf', '' ),
	array( 'https://safe.test\\@evil.test/file.pdf', '' ),
	array( 'https://safe.test/files\\report.pdf', 'https://safe.test/files\\report.pdf' ),
	array( 'https://exam%E2%81%A6ple.org/file.pdf', '' ),
	array( '//exa%E2%80%8Bmple.org/file.pdf', '' ),
	array( 'https://مثال.إختبار/file.pdf', 'https://مثال.إختبار/file.pdf' ),
);

foreach ( $attachments as $case ) {
	if ( slateframe_attachment_file_url( $case[0] ) !== $case[1] ) {
		throw new RuntimeException( 'Invalid attachment host result: ' . $case[0] );
	}
}

echo count( $urls ) . ' web media URL cases, ' . count( $images ) . ' srcset cases and ' . count( $attachments ) . " attachment cases passed\n";
