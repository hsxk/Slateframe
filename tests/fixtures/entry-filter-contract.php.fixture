<?php
/** Disposable WordPress function stubs for template filter boundary tests. */
define( 'ABSPATH', __DIR__ . '/' );
function wp_strip_all_tags( $value ) { return strip_tags( $value ); }
class WP_Error {}
$GLOBALS['slateframe_test_filters'] = array();
$GLOBALS['slateframe_test_post_type'] = 'post';
$GLOBALS['slateframe_test_author'] = 'Writer';
function get_post_type() { return $GLOBALS['slateframe_test_post_type']; }
function get_the_author_meta( $key ) { return 3; }
function get_the_author() { return $GLOBALS['slateframe_test_author']; }
function get_author_posts_url( $id ) { return '/author/' . $id . '/'; }
function get_the_date( $format = '' ) { return '2026-10-24'; }
function get_the_ID() { return 10; }
function get_the_category_list( $separator ) { return '<a href="/category">Category</a>'; }
function get_the_tag_list( $before, $separator ) { return '<a href="/tag">Tag</a>'; }
function esc_html_x( $value, $context, $domain ) { return $value; }
function esc_html__( $value, $domain ) { return $value; }
function esc_html( $value ) { return htmlspecialchars( (string) $value, ENT_QUOTES, 'UTF-8' ); }
function esc_attr( $value ) { return esc_html( $value ); }
function esc_url_raw( $url ) {
    if ( ! is_string( $url ) ) { throw new TypeError( 'Invalid URL type' ); }
    return preg_match( '/^(?:javascript|data):/i', $url ) ? '' : trim( $url );
}
function esc_url( $url ) {
    if ( ! is_string( $url ) ) { throw new TypeError( 'Invalid URL type' ); }
    return esc_html( $url );
}
function wp_kses_post( $html ) {
    if ( ! is_string( $html ) ) { throw new TypeError( 'Invalid HTML type' ); }
    return $html;
}
function apply_filters( $hook, $value, ...$args ) {
    return array_key_exists( $hook, $GLOBALS['slateframe_test_filters'] )
        ? $GLOBALS['slateframe_test_filters'][ $hook ] : $value;
}
require dirname( __DIR__, 2 ) . '/inc/template-tags.php';
function slateframe_test_render( $method ) {
    ob_start();
    $method();
    return ob_get_clean();
}
function slateframe_test_check( $ok, $message ) {
    if ( ! $ok ) { throw new RuntimeException( $message ); }
}
$cases = 0;
function slateframe_test_case( $message, $predicate ) {
    global $cases;
    slateframe_test_check( $predicate, $message );
    ++$cases;
}
$default = slateframe_test_render( 'slateframe_entry_meta' );
slateframe_test_case( 'Default author link disappeared', str_contains( $default, 'href="/author/3/"' ) );
foreach ( array( false, array( '/about' ), new WP_Error(), 'javascript:alert(1)', 'data:text/html,unsafe' ) as $invalid ) {
    $GLOBALS['slateframe_test_filters']['slateframe_author_url'] = $invalid;
    $html = slateframe_test_render( 'slateframe_entry_meta' );
    slateframe_test_case( 'Invalid author destination generated an anchor', ! str_contains( $html, '<a ' ) );
    slateframe_test_case( 'Invalid author destination hid the author', str_contains( $html, 'Writer' ) );
}
$GLOBALS['slateframe_test_filters']['slateframe_author_url'] = '/about';
slateframe_test_case( 'Valid adapter URL was dropped', str_contains( slateframe_test_render( 'slateframe_entry_meta' ), 'href="/about"' ) );
$GLOBALS['slateframe_test_author'] = '<script>alert(1)</script>';
slateframe_test_case( 'Author name was not escaped', str_contains( slateframe_test_render( 'slateframe_entry_meta' ), '&lt;script&gt;' ) );
$GLOBALS['slateframe_test_author'] = 'Writer';
$GLOBALS['slateframe_test_filters'] = array(
    'slateframe_entry_categories_html' => new WP_Error(),
    'slateframe_entry_tags_html' => array( '<script>bad</script>' ),
);
slateframe_test_case( 'Malformed taxonomy HTML should not render footer', '' === slateframe_test_render( 'slateframe_entry_footer' ) );
$GLOBALS['slateframe_test_filters']['slateframe_entry_categories_html'] = '<a href="/category">Category</a>';
slateframe_test_case( 'Valid category should survive malformed tag adapter', str_contains( slateframe_test_render( 'slateframe_entry_footer' ), 'Category' ) );
$GLOBALS['slateframe_test_post_type'] = 'page';
slateframe_test_case( 'Page should not have post-only byline', '' === slateframe_test_render( 'slateframe_entry_meta' ) );
slateframe_test_case( 'Page should not have post-only taxonomy', '' === slateframe_test_render( 'slateframe_entry_footer' ) );
echo "Entry filter boundaries: {$cases} cases passed\n";
