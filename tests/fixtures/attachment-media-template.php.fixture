slateframe_attachment_check( false === strpos( $nonmedia_video, '<figure class="alignwide">' ), 'Non-video HTML created video figure' );
slateframe_attachment_check( false === strpos( $nonmedia_video, 'Orphan filtered video caption' ), 'Non-video HTML leaked caption' );
$nonmedia_audio = slateframe_attachment_render( array(
    'url' => 'https://example.org/audio.mp3', 'mime' => 'audio/mpeg',
    'audio_shortcode' => '<video controls></video>', 'caption' => 'Orphan filtered audio caption',
) );
slateframe_attachment_check( false === strpos( $nonmedia_audio, '<figure class="alignwide">' ), 'Wrong media element created audio figure' );
slateframe_attachment_check( false === strpos( $nonmedia_audio, 'Orphan filtered audio caption' ), 'Wrong media element leaked caption' );
foreach ( array( '&#x200B;', '<em></em>', '&#x3164;' ) as $hidden_caption ) {
    $hidden = slateframe_attachment_render( array( 'image' => true, 'image_html' => '<img src="/photo.jpg">', 'caption' => $hidden_caption ) );
    slateframe_attachment_check( false === strpos( $hidden, '<figcaption' ), 'Invisible image caption created figcaption' );
}
$hidden_video = slateframe_attachment_render( array( 'url' => 'https://example.org/video.mp4', 'mime' => 'video/mp4', 'caption' => '&#x200B;' ) );
slateframe_attachment_check( false === strpos( $hidden_video, '<figcaption' ), 'Invisible video caption created figcaption' );
$hidden_audio = slateframe_attachment_render( array( 'url' => 'https://example.org/audio.mp3', 'mime' => 'audio/mpeg', 'caption' => '&#x3164;' ) );
slateframe_attachment_check( false === strpos( $hidden_audio, '<figcaption' ), 'Invisible audio caption created figcaption' );
echo 'Attachment media template: ' . $GLOBALS['slateframe_attachment_checks'] . " assertions passed\n";
