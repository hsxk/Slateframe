<?php
/** Execute the real attachment template against malformed Core media adapters. */
define( 'ABSPATH', dirname( __DIR__, 2 ) . '/' );
$GLOBALS['slateframe_attachment_case'] = array();
$GLOBALS['slateframe_attachment_checks'] = 0;
$GLOBALS['slateframe_attachment_loop'] = 0;
function get_header() {}
function get_footer() {}
function have_posts() { return 0 === $GLOBALS['slateframe_attachment_loop']; }
function the_post() { ++$GLOBALS['slateframe_attachment_loop']; }
function get_the_ID() { return 42; }
function post_class( $class ) { echo 'class="' . $class . '"'; }
function slateframe_public_attachment_parent_id( $id ) { return ! empty( $GLOBALS['slateframe_attachment_case']['parent'] ) ? 27 : 0; }
function slateframe_get_display_title( $id = 0 ) { return 27 === $id ? '親ページ' : '写真と記事'; }
function wp_get_attachment_url( $id ) { return $GLOBALS['slateframe_attachment_case']['url']; }
function get_post_mime_type( $id ) { return $GLOBALS['slateframe_attachment_case']['mime']; }
function wp_get_attachment_caption( $id ) { return $GLOBALS['slateframe_attachment_case']['caption']; }
function slateframe_attachment_details( $id ) { return array( 'Dimensions' => '1920 × 1080 px' ); }
function wp_attachment_is_image( $id ) { return ! empty( $GLOBALS['slateframe_attachment_case']['image'] ); }
function wp_get_attachment_image( $id, $size, $icon, $attrs ) {
    $GLOBALS['slateframe_attachment_attrs'] = $attrs;
    return $GLOBALS['slateframe_attachment_case']['image_html'];
}
function wp_video_shortcode( $args ) {
    if ( array_key_exists( 'video_shortcode', $GLOBALS['slateframe_attachment_case'] ) ) {
        return $GLOBALS['slateframe_attachment_case']['video_shortcode'];
    }
    return '<video src="' . htmlspecialchars( $args['src'], ENT_QUOTES, 'UTF-8' ) . '"></video>';
}
function wp_audio_shortcode( $args ) {
    if ( array_key_exists( 'audio_shortcode', $GLOBALS['slateframe_attachment_case'] ) ) {
        return $GLOBALS['slateframe_attachment_case']['audio_shortcode'];
    }
    return '<audio src="' . htmlspecialchars( $args['src'], ENT_QUOTES, 'UTF-8' ) . '"></audio>';
}
function get_the_content() { return $GLOBALS['slateframe_attachment_case']['content']; }
function the_content() { echo $GLOBALS['slateframe_attachment_case']['content']; }
function esc_attr_e( $text, $domain ) { echo htmlspecialchars( $text, ENT_QUOTES, 'UTF-8' ); }
function esc_html_e( $text, $domain ) { echo htmlspecialchars( $text, ENT_QUOTES, 'UTF-8' ); }
function esc_html__( $text, $domain ) { return htmlspecialchars( $text, ENT_QUOTES, 'UTF-8' ); }
function esc_html( $text ) { return htmlspecialchars( $text, ENT_QUOTES, 'UTF-8' ); }
function esc_url_raw( $url ) {
    if ( ! is_string( $url ) ) { throw new TypeError( 'Unsafe URL type' ); }
    if ( '' === trim( $url ) || 0 === stripos( $url, 'javascript:' ) ) { return ''; }
    return trim( $url );
}
function esc_url( $url ) { return htmlspecialchars( esc_url_raw( $url ), ENT_QUOTES, 'UTF-8' ); }
function wp_kses_post( $value ) {
    if ( ! is_string( $value ) ) { throw new TypeError( 'Nonstring HTML' ); }
    $value = preg_replace( '~<script\\b[^>]*>.*?</script>~is', '', $value );
    $value = preg_replace( '~\\s+onerror\\s*=\\s*"[^"]*"~i', '', $value );
    // Mirror Core post KSES: priority and decoding must be restored after sanitization.
    return preg_replace( '~\\s+(?:fetchpriority|decoding)\\s*=\\s*"[^"]*"~i', '', $value );
}
function get_permalink( $id ) { return '/parent/' . $id; }
function comments_open() { return false; }
function get_comments_number() { return 0; }
class WP_HTML_Tag_Processor {
    private $html;
    private $matched = false;
    private $tag = '';
    private $offset = 0;
    public function __construct( $html ) { $this->html = $html; }
    public function next_tag( $name ) {
        if ( ! preg_match( '/<' . preg_quote( $name, '/' ) . '(?=[\\s\\/>])[^>]*>/i', $this->html, $match, PREG_OFFSET_CAPTURE, $this->offset ) ) {
            $this->matched = false;
            return false;
        }
        $this->matched = true;
        $this->tag = $match[0][0];
        $this->offset = $match[0][1] + strlen( $match[0][0] );
        return true;
    }
    public function get_attribute( $name ) {
        if ( ! $this->matched ) { return null; }
        if ( ! preg_match( '/\\s' . preg_quote( $name, '/' ) . '="([^"]*)"/i', $this->tag, $value ) ) { return null; }
        return html_entity_decode( $value[1], ENT_QUOTES, 'UTF-8' );
    }
    public function set_attribute( $name, $value ) {
        if ( ! $this->matched ) { throw new RuntimeException( 'No image selected' ); }
        $this->html = preg_replace_callback( '/<img\\b[^>]*>/i', static function ( $match ) use ( $name, $value ) {
            $tag = preg_replace( '/\\s+' . preg_quote( $name, '/' ) . '="[^"]*"/i', '', $match[0] );
            return preg_replace( '/<img\\b/i', '<img ' . $name . '="' . $value . '"', $tag, 1 );
        }, $this->html, 1 );
    }
    public function get_updated_html() { return $this->html; }
}
function slateframe_has_readable_label( $text ) {
    if ( ! is_string( $text ) ) { return false; }
    return 1 === preg_match( '/[^\p{Z}\p{Cc}\p{Cf}\p{M}\x{115F}\x{1160}\x{3164}\x{FFA0}\x{2800}\s]/u',
        html_entity_decode( strip_tags( $text ), ENT_QUOTES | ENT_HTML5, 'UTF-8' ) );
}
function slateframe_attachment_check( $ok, $message ) {
    if ( ! $ok ) { throw new RuntimeException( $message ); }
    ++$GLOBALS['slateframe_attachment_checks'];
}
function slateframe_attachment_render( $case ) {
    $GLOBALS['slateframe_attachment_case'] = array_merge(
        array( 'url' => '', 'mime' => '', 'caption' => '', 'image' => false, 'image_html' => '', 'parent' => false, 'content' => '' ),
        $case
    );
    $GLOBALS['slateframe_attachment_loop'] = 0;
    ob_start();
    try {
        include dirname( __DIR__, 2 ) . '/attachment.php';
        return ob_get_clean();
    } catch ( Throwable $error ) {
        ob_end_clean();
        throw $error;
    }
}
set_error_handler( function( $severity, $message ) { throw new ErrorException( $message, 0, $severity ); } );
$valid = slateframe_attachment_render( array(
    'url' => 'https://example.org/uploads/photo.jpg', 'mime' => 'image/jpeg',
    'caption' => '<em>花の写真</em>', 'image' => true,
    'image_html' => '<img src="/photo.jpg" alt="花" srcset="/small.jpg 1x, /large.jpg 2x">',
    'parent' => true,
) );
slateframe_attachment_check( false !== strpos( $valid, '<dl class="slateframe-entry-footer"' ), 'Native attachment metadata definition list missing' );
slateframe_attachment_check( false !== strpos( $valid, '<dt class="slateframe-entry-footer-label"><bdi>Dimensions</bdi></dt>' ), 'Metadata term or bidi isolation missing' );
slateframe_attachment_check( false !== strpos( $valid, '<dd><bdi>1920 × 1080 px</bdi></dd>' ), 'Metadata definition or bidi isolation missing' );
slateframe_attachment_check( 1 === substr_count( $valid, '<figure class="alignwide">' ), 'Valid image figure missing' );
slateframe_attachment_check( false !== strpos( $valid, 'alt="花"' ), 'CJK alt lost' );
slateframe_attachment_check( false !== strpos( $valid, '<figcaption class="wp-caption-text"><em>花の写真</em></figcaption>' ), 'CJK caption lost' );
slateframe_attachment_check( false !== strpos( $valid, 'srcset="/small.jpg 1x, /large.jpg 2x"' ), 'Core srcset lost' );
slateframe_attachment_check( false !== strpos( $valid, 'href="/parent/27"' ), 'Public parent recovery link lost' );
slateframe_attachment_check( false !== strpos( $valid, 'href="https://example.org/uploads/photo.jpg"' ), 'Original file link lost' );
slateframe_attachment_check( 'high' === $GLOBALS['slateframe_attachment_attrs']['fetchpriority'], 'Hero priority lost' );
slateframe_attachment_check( false !== strpos( $valid, 'fetchpriority="high"' ), 'Rendered attachment priority lost after KSES' );
slateframe_attachment_check( false !== strpos( $valid, 'decoding="async"' ), 'Rendered attachment decoding lost after KSES' );
slateframe_attachment_check( false !== strpos( $valid, 'loading="eager"' ), 'Rendered attachment loading lost after KSES' );
$unsafe = slateframe_attachment_render( array(
    'image' => true, 'image_html' => '<img src="/photo.jpg" alt="花" srcset="/small.jpg 1x, /large.jpg 2x" loading="lazy" decoding="sync" fetchpriority="low" onerror="alert(1)"><script>alert(2)</script>',
    'caption' => '<em>照片说明</em>',
) );
slateframe_attachment_check( false === strpos( $unsafe, '<script' ), 'Filtered image script leaked' );
slateframe_attachment_check( false === strpos( $unsafe, 'onerror' ), 'Filtered image event handler leaked' );
slateframe_attachment_check( false !== strpos( $unsafe, 'fetchpriority="high"' ) && false === strpos( $unsafe, 'fetchpriority="low"' ), 'Filtered priority not replaced' );
slateframe_attachment_check( false !== strpos( $unsafe, 'decoding="async"' ) && false === strpos( $unsafe, 'decoding="sync"' ), 'Filtered decoding not replaced' );
slateframe_attachment_check( false !== strpos( $unsafe, 'loading="eager"' ) && false === strpos( $unsafe, 'loading="lazy"' ), 'Filtered loading not replaced' );
slateframe_attachment_check( false !== strpos( $unsafe, 'srcset="/small.jpg 1x, /large.jpg 2x"' ), 'Filtered responsive srcset lost' );
slateframe_attachment_check( false !== strpos( $unsafe, 'alt="花"' ), 'Filtered CJK alt lost' );
slateframe_attachment_check( false !== strpos( $unsafe, '<em>照片说明</em>' ), 'Filtered CJK caption lost' );
// A filtered image without a usable src or srcset is not a preview.
foreach ( array( '<img alt="missing source">', '<img src="" alt="empty source">', '<img src="   " alt="blank source">', '<img srcset="   " alt="blank candidates">' ) as $source_less ) {
    $no_source = slateframe_attachment_render( array(
        'url' => 'https://example.org/photo.jpg', 'image' => true,
        'image_html' => $source_less, 'caption' => 'Orphan source-less caption',
    ) );
    slateframe_attachment_check( false === strpos( $no_source, '<figure class="alignwide">' ), 'Source-less image created a figure' );
    slateframe_attachment_check( false === strpos( $no_source, 'Orphan source-less caption' ), 'Source-less image leaked caption' );
    slateframe_attachment_check( false !== strpos( $no_source, 'Open original file' ), 'Source-less image lost safe original link' );
}
$srcset_only = slateframe_attachment_render( array(
    'image' => true, 'image_html' => '<img srcset="/small.jpg 1x, /large.jpg 2x" alt="响应式图片">',
) );
slateframe_attachment_check( false !== strpos( $srcset_only, '<figure class="alignwide">' ), 'Valid srcset-only image lost figure' );
slateframe_attachment_check( false !== strpos( $srcset_only, 'fetchpriority="high"' ), 'Srcset-only image lost priority' );
foreach ( array( false, null, 0, array( 'img' ), new stdClass(), '', ' ', '<p>not an image</p>' ) as $bad ) {
    $html = slateframe_attachment_render( array( 'image' => true, 'image_html' => $bad, 'caption' => '<em>Hidden caption</em>' ) );
    slateframe_attachment_check( false === strpos( $html, '<figure class="alignwide">' ), 'Malformed image created empty figure' );
    slateframe_attachment_check( false === strpos( $html, 'Hidden caption' ), 'Orphan caption escaped without image' );
}
$bad = slateframe_attachment_render( array( 'url' => array( 'https://example.org/secret' ), 'mime' => array( 'video/mp4' ), 'caption' => array( 'private' ) ) );
slateframe_attachment_check( false === strpos( $bad, 'Open original file</a>' ), 'Array URL leaked a link' );
slateframe_attachment_check( false === strpos( $bad, '<video' ), 'Array MIME triggered video' );
slateframe_attachment_check( false === strpos( $bad, 'private' ), 'Array caption leaked' );
$bad = slateframe_attachment_render( array( 'url' => new stdClass(), 'mime' => new stdClass(), 'caption' => new stdClass() ) );
slateframe_attachment_check( false === strpos( $bad, 'Open original file</a>' ), 'Object URL leaked a link' );
$bad = slateframe_attachment_render( array( 'url' => 'javascript:alert(1)', 'mime' => 'video/mp4' ) );
slateframe_attachment_check( false === strpos( $bad, '<video' ), 'Unsafe URL triggered video shortcode' );
slateframe_attachment_check( false === strpos( $bad, 'Open original file</a>' ), 'Unsafe original file link leaked' );
$video = slateframe_attachment_render( array( 'url' => 'https://example.org/video.mp4', 'mime' => 'video/mp4' ) );
slateframe_attachment_check( false !== strpos( $video, '<video src="https://example.org/video.mp4"' ), 'Native video preview lost' );
$audio = slateframe_attachment_render( array( 'url' => 'https://example.org/audio.mp3', 'mime' => 'audio/mpeg' ) );
slateframe_attachment_check( false !== strpos( $audio, '<audio src="https://example.org/audio.mp3"' ), 'Native audio preview lost' );
slateframe_attachment_check( false === strpos( $audio, 'href="/parent/27"' ), 'Orphan attachment acquired a parent link' );
$bad_video = slateframe_attachment_render( array( 'url' => 'https://example.org/video.mp4', 'mime' => 'video/mp4', 'video_shortcode' => array( 'unsafe' ) ) );
slateframe_attachment_check( false === strpos( $bad_video, '<video' ), 'Malformed video shortcode output reached HTML' );
slateframe_attachment_check( false !== strpos( $bad_video, 'Open original file' ), 'Malformed video shortcode removed safe original link' );
$bad_audio = slateframe_attachment_render( array( 'url' => 'https://example.org/audio.mp3', 'mime' => 'audio/mpeg', 'audio_shortcode' => new stdClass() ) );
slateframe_attachment_check( false === strpos( $bad_audio, '<audio' ), 'Malformed audio shortcode output reached HTML' );
slateframe_attachment_check( false !== strpos( $bad_audio, 'Open original file' ), 'Malformed audio shortcode removed safe original link' );

// Empty/blank shortcode shells must not create a media figure or caption.
foreach ( array( 'video', 'audio' ) as $kind ) {
    $extension = 'video' === $kind ? 'mp4' : 'mp3';
    $mime = 'video' === $kind ? 'video/mp4' : 'audio/mpeg';
    $empty = slateframe_attachment_render( array(
        'url' => 'https://example.org/clip.' . $extension, 'mime' => $mime,
        $kind . '_shortcode' => '<' . $kind . ' controls></' . $kind . '>',
        'caption' => 'Orphan source-less caption',
    ) );
    slateframe_attachment_check( false === strpos( $empty, '<figure class="alignwide">' ), 'Empty ' . $kind . ' shell created figure' );
    slateframe_attachment_check( false === strpos( $empty, 'Orphan source-less caption' ), 'Empty ' . $kind . ' shell leaked caption' );

    $blank = slateframe_attachment_render( array(
        'url' => 'https://example.org/clip.' . $extension, 'mime' => $mime,
        $kind . '_shortcode' => '<' . $kind . ' src="  "><source src="  "></' . $kind . '>',
        'caption' => 'Orphan blank-source caption',
    ) );
    slateframe_attachment_check( false === strpos( $blank, '<figure class="alignwide">' ), 'Blank ' . $kind . ' source created figure' );
    slateframe_attachment_check( false === strpos( $blank, 'Orphan blank-source caption' ), 'Blank ' . $kind . ' source leaked caption' );

    $source = slateframe_attachment_render( array(
        'url' => 'https://example.org/clip.' . $extension, 'mime' => $mime,
        $kind . '_shortcode' => '<' . $kind . ' controls><source src="/first.' . $extension . '"></' . $kind . '>',
        'caption' => 'Readable source caption',
    ) );
    slateframe_attachment_check( false !== strpos( $source, '<figure class="alignwide">' ), 'Nested ' . $kind . ' source lost figure' );
    slateframe_attachment_check( false !== strpos( $source, 'Readable source caption' ), 'Nested ' . $kind . ' source lost caption' );
}
$multiple = slateframe_attachment_render( array(
    'url' => 'https://example.org/movie.mp4', 'mime' => 'video/mp4',
    'video_shortcode' => '<video controls><source src=" "><source src="/fallback.webm"></video>',
) );
slateframe_attachment_check( false !== strpos( $multiple, '<figure class="alignwide">' ), 'Later valid video source candidate ignored' );
$multiple_audio = slateframe_attachment_render( array(
    'url' => 'https://example.org/song.mp3', 'mime' => 'audio/mpeg',
    'audio_shortcode' => '<audio controls><source src=" "><source src="/fallback.ogg"></audio>',
