<?php
/** Execute the actual footer against Core-style display-filtered identity. */
define( 'ABSPATH', __DIR__ );
function wp_strip_all_tags( $value ) { return strip_tags( $value ); }
require dirname( __DIR__, 2 ) . '/inc/template-tags.php';
$GLOBALS['slateframe_footer_name'] = '';
$GLOBALS['slateframe_footer_description'] = '';
function get_bloginfo( $key, $filter = 'raw' ) {
	if ( 'name' === $key ) {
		return $GLOBALS['slateframe_footer_name'];
	}
	return $GLOBALS['slateframe_footer_description'];
}
function bloginfo( $key ) { echo htmlspecialchars( get_bloginfo( $key, 'display' ), ENT_QUOTES, 'UTF-8' ); }
function is_active_sidebar( $key ) { return false; }
function has_nav_menu( $key ) { return false; }
function wp_date( $format ) { return '2026'; }
function esc_html( $text ) { return htmlspecialchars( $text, ENT_QUOTES, 'UTF-8' ); }
function esc_html_e( $text, $domain ) { echo htmlspecialchars( $text, ENT_QUOTES, 'UTF-8' ); }
function wp_footer() {}
$cases = array(
	array( '', '', 'Home', false ),
	array( ' ', '日本語', 'Home', false ),
	array( '&nbsp;', '&nbsp;', 'Home', false ),
	array( "\u{200B}", "\u{FE0F}", 'Home', false ),
	array( "\u{3164}", '', 'Home', false ),
	array( false, array( 'broken' ), 'Home', false ),
	array( 'Slateframe', '', 'Slateframe', true ),
	array( '日本語', 'العربية', '日本語', true ),
	array( 'العربية', '中文', 'العربية', true ),
	array( '0', '日本語', '0', true ),
	array( '👩‍💻', '', '👩‍💻', true ),
	array( '<script>alert(1)</script>', '', '<script>alert(1)</script>', true ),
);
foreach ( $cases as $i => $case ) {
	$GLOBALS['slateframe_footer_name'] = $case[0];
	$GLOBALS['slateframe_footer_description'] = $case[1];
	ob_start();
	include dirname( __DIR__, 2 ) . '/footer.php';
	$html = ob_get_clean();
	if ( ! preg_match( '/<strong><bdi>(.*?)<\/bdi><\/strong>/s', $html, $match ) ) {
		throw new RuntimeException( 'Missing footer identity case ' . $i );
	}
	$label = trim( html_entity_decode( strip_tags( $match[1] ), ENT_QUOTES | ENT_HTML5, 'UTF-8' ) );
	if ( $case[2] !== $label ) {
		throw new RuntimeException( 'Wrong identity case ' . $i . ': ' . $label );
	}
	if ( ! preg_match( '/<p class="slateframe-copyright">(.*?)<\/p>/s', $html, $copyright ) ) {
		throw new RuntimeException( 'Missing copyright case ' . $i );
	}
	if ( 1 !== substr_count( $copyright[1], '<bdi>' ) + ( $case[3] ? -1 : 0 ) ) {
		throw new RuntimeException( 'Wrong copyright boundaries case ' . $i );
	}
	if ( $case[3] && false === strpos( $copyright[1], htmlspecialchars( $case[2], ENT_QUOTES, 'UTF-8' ) ) ) {
		throw new RuntimeException( 'Missing readable copyright owner case ' . $i );
	}
	if ( ! slateframe_has_readable_label( $case[1] ) && false !== strpos( $html, '<p><bdi>' ) ) {
		throw new RuntimeException( 'Invisible tagline case ' . $i );
	}
	if ( false !== strpos( $html, '<script>alert(1)</script>' ) ) {
		throw new RuntimeException( 'Unescaped title case ' . $i );
	}
}
echo 'Footer readable identity: ' . count( $cases ) . " cases passed\n";