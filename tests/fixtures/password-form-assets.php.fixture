<?php
/**
 * Isolate real form and enqueue functions against Core-like password states.
 *
 * @package Slateframe
 */
$source = file_get_contents( dirname( __DIR__, 2 ) . '/functions.php' );
$forms_begin = strpos( $source, 'function slateframe_forms_styles_needed() {' );
$forms_end = strpos( $source, 'function slateframe_form_content_styles_needed() {', $forms_begin );
$assets_begin = strpos( $source, 'function slateframe_assets() {' );
$assets_end = strpos( $source, "add_action( 'wp_enqueue_scripts', 'slateframe_assets' );", $assets_begin );
if ( false === $forms_begin || false === $forms_end || false === $assets_begin || false === $assets_end ) {
    fwrite( STDERR, "Could not isolate real Slateframe functions.\n" );
    exit( 1 );
}
$forms_code = substr( $source, $forms_begin, $forms_end - $forms_begin );
$assets_code = substr( $source, $assets_begin, $assets_end - $assets_begin );
$temp = tempnam( sys_get_temp_dir(), 'slateframe-password-' );
if ( false === $temp || false === file_put_contents( $temp, '<?php ' . $forms_code . "\n" . $assets_code ) ) {
    fwrite( STDERR, "Could not create isolated PHP fixture.\n" );
    exit( 1 );
}
try {
    require $temp;
} finally {
    unlink( $temp );
}
$flags = json_decode( getenv( 'SLATEFRAME_PASSWORD_CASE' ), true );
if ( ! is_array( $flags ) ) {
    fwrite( STDERR, "Missing case flags.\n" );
    exit( 1 );
}
$GLOBALS['sf_flags'] = $flags;
$GLOBALS['sf_styles'] = array();
$GLOBALS['sf_scripts'] = array();
$GLOBALS['wp_query'] = (object) array( 'post_count' => 2 );
class WP_Post {
    public $post_content = '';
}
function sf_flag( $name ) { return ! empty( $GLOBALS['sf_flags'][ $name ] ); }
function is_singular() { return sf_flag( 'singular' ); }
function post_password_required() { return sf_flag( 'locked' ); }
function comments_open() { return sf_flag( 'open' ); }
function get_comments_number() { return sf_flag( 'history' ) ? 3 : 0; }
function get_post() { $post = new WP_Post(); $post->post_content = sf_flag( 'authored_form' ) ? '<form></form>' : ''; return $post; }
function has_block( $block, $post ) { return false; }
function slateframe_content_has_form( $content ) { return false !== strpos( $content, '<form' ); }
function apply_filters( $name, $value ) { return 'slateframe_forms_styles_needed' === $name && sf_flag( 'disable_forms_filter' ) ? false : $value; }
function slateframe_footer_form_assets() { return array( 'forms' => false, 'search_form' => false, 'form_content' => false ); }
function slateframe_singular_synced_form_assets() { return array( 'forms' => false, 'search_form' => false, 'form_content' => false ); }
function slateframe_footer_presentation_assets() { return array( 'photography' => false, 'content_modes' => false, 'query_loop' => false ); }
function slateframe_photography_styles_needed() { return false; }
function slateframe_content_modes_needed() { return false; }
function slateframe_query_loop_styles_needed() { return false; }
function slateframe_form_content_styles_needed() { return sf_flag( 'form_content' ); }
function slateframe_search_form_styles_needed() { return sf_flag( 'search_form' ); }
function is_home() { return false; }
function is_archive() { return false; }
function is_search() { return false; }
function is_author() { return false; }
function is_404() { return false; }
function is_rtl() { return sf_flag( 'rtl' ); }
function get_option( $name ) { return 'thread_comments' === $name && sf_flag( 'thread' ); }
function get_stylesheet_uri() { return '/themes/slateframe/style.css'; }
function get_template_directory_uri() { return '/themes/slateframe'; }
function wp_get_theme() { return new class() { public function get( $key ) { return '0.1.0'; } }; }
function wp_enqueue_style( $handle, $src, $dependencies, $version, $media = 'all' ) {
    $GLOBALS['sf_styles'][ $handle ] = $dependencies;
}
function wp_enqueue_script( $handle ) { $GLOBALS['sf_scripts'][] = $handle; }
$helper = slateframe_forms_styles_needed();
slateframe_assets();
foreach ( $GLOBALS['sf_styles'] as $handle => $dependencies ) {
    foreach ( $dependencies as $dependency ) {
        if ( ! isset( $GLOBALS['sf_styles'][ $dependency ] ) ) {
            fwrite( STDERR, "Missing CSS dependency $dependency for $handle\n" );
            exit( 2 );
        }
    }
}
echo json_encode( array(
    'helper' => $helper,
    'styles' => array_keys( $GLOBALS['sf_styles'] ),
    'scripts' => $GLOBALS['sf_scripts'],
), JSON_THROW_ON_ERROR );
